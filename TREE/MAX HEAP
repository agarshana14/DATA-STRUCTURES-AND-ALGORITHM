#include <stdio.h>

int main() {
    int heap[10], size = 0;
    int value, i;
    int n;
    scanf("%d",&n);//3

    printf("Enter %d elements:\n",n);
    for (int j = 0; j < n; j++) {//3<3
        scanf("%d", &value);//3

        heap[size] = value;//0->1,1->2,2->3
        i = size;//2
        size++;//3

        // Heapify up (Max Heap)
        while (i > 0 && heap[(i - 1) / 2] < heap[i]) {//2<3
            int temp = heap[i];//3
            heap[i] = heap[(i - 1) / 2];//1
            heap[(i - 1) / 2] = temp;
            i = (i - 1) / 2;//0
            
        }
    }

    printf("Max Heap: ");
    for (int k = 0; k < size; k++)
        printf("%d ", heap[k]);

    return 0;
}
