#include<stdio.h>
int main() {
	int n,w;
	printf("Enter number of items: ");
	scanf("%d",&n);
	int val[n],wt[n];

	for(int i=0; i<n; i++) {
		printf("enter value and weights of item %d:",i+1);
		scanf("%d %d",&val[i],&wt[i]);
	}


	printf("Enter knapsack capacity:");
	scanf("%d",&w);

	int dp[w+1];

	for(int i=0; i<=w; i++)
		dp[i]=0;

	for(int i=0; i<n; i++) {
		for(int u=w; u>=wt[i]; u--) {
			if(dp[u-wt[i]]+val[i]>dp[u]) {
			  dp[u]=dp[u-wt[i]]+val[i];
			}
		}
	}
	printf("Max=%d\n",dp[w]);
	return 0;
